# =============================================================================
# Living Memory — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# --- Google Gemini (required) ------------------------------------------------
# Used for: photo understanding, story generation, fact extraction, style transfer,
#           VEO 3 animation, Nano Banana extraction, TTS, Gemini Live
GEMINI_API_KEY=

# --- Supabase (required) ----------------------------------------------------
# Used for: auth, database, file storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs (required for voice cloning) ---------------------------------
# Used for: voice cloning, narration with cloned voices
ELEVENLABS_API_KEY=

# --- Google Cloud (optional — fallback TTS) ----------------------------------
# Used for: Google Cloud Text-to-Speech when no cloned voice exists
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=

# --- xAI / Grok (optional — alternative animation) --------------------------
# Used for: Grok Imagine animation engine (alternative to VEO 3)
XAI_API_KEY=

# --- App Config (optional) ---------------------------------------------------
# Base URL for internal API calls (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_BASE_URL=
